{
  "name": "@gtmagentcy/aai",
  "version": "0.4.0",
  "description": "AAI (Agent Application Interface): lint a site, build its llms.txt, agents.md, OpenAPI and MCP card, and measure the agent funnel with server, action and browser taps and a local dashboard.",
  "type": "module",
  "bin": {
    "aai": "cli/aai.mjs",
    "aai-lint": "cli/aai-lint.mjs"
  },
  "files": [
    "cli",
    "app",
    "lib",
    "collector",
    "taps",
    "pixel",
    "templates",
    "components",
    "examples/demo-site",
    "SPEC.md",
    "LICENSE-docs.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "aai",
    "agent-analytics",
    "agent-funnel",
    "agent-readiness",
    "agents",
    "agents.md",
    "ai-agents",
    "ai-agents-tracking",
    "llms.txt",
    "mcp",
    "web-bot-auth"
  ],
  "author": "Netanel Baruch <netanel@gtmagentcy.com> (https://gtmagentcy.com)",
  "license": "MIT",
  "homepage": "https://gtmagentcy.com/aai/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gtmagentcy/aai.git"
  },
  "exports": {
    "./taps/node.js": "./taps/node.js",
    "./taps/fetch.js": "./taps/fetch.js",
    "./taps/mcp.js": "./taps/mcp.js",
    "./taps/core.js": "./taps/core.js",
    "./lib/agents.js": "./lib/agents.js",
    "./collector/store.js": "./collector/store.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "node cli/aai.mjs serve",
    "demo": "node cli/aai.mjs demo",
    "test": "node --test test/"
  },
  "publishConfig": {
    "access": "public"
  }
}
